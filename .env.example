# The controlled pilot file is created from testnet.example.json only after its public
# registry address and activation boundary are known. It must contain profileId
# commons-testnet-xcs-v0.1-controlled-pilot and is never reused for the public beta.
# Compose container path. For a local pnpm indexer process, use the equivalent ./config/... path.
XCS_NETWORK_PROFILE=/workspace/config/networks/commons-testnet-xcs-v0.1-controlled-pilot.json
XCS_DATABASE_SCOPE=exclusive-profile
# db:bootstrap creates fixed cluster-wide roles and is safe only on a dedicated cluster.
XCS_DATABASE_CLUSTER_SCOPE=dedicated
XCS_BIND_ADDRESS=127.0.0.1
# Direct values support local Compose and host-side pnpm commands. A hosted deployment must also
# set the corresponding *_FILE paths below and use docker-compose.secrets.yml, which removes these
# values from the rendered container environment.
XCS_POSTGRES_ADMIN_PASSWORD=replace-with-a-long-url-safe-random-admin-password
XCS_POSTGRES_ADMIN_PASSWORD_FILE=./ops/secrets/postgres_admin_password
XCS_INDEXER_DATABASE_PASSWORD=replace-with-a-long-url-safe-random-indexer-password
XCS_INDEXER_DATABASE_PASSWORD_FILE=./ops/secrets/indexer_database_password
XCS_API_DATABASE_PASSWORD=replace-with-a-long-url-safe-random-api-password
# The production API reads this ignored file; for local direct-value use its contents must exactly
# match XCS_API_DATABASE_PASSWORD.
XCS_API_DATABASE_PASSWORD_FILE=./ops/secrets/api_database_password
# Dedicated pg_monitor identity for postgres-exporter; it has no application-table DML rights. The
# file must contain the same value used by local direct-value bootstrap.
XCS_MONITOR_DATABASE_PASSWORD=replace-with-a-long-url-safe-random-monitor-password
XCS_MONITOR_DATABASE_PASSWORD_FILE=./ops/secrets/monitor_database_password
# Shared only by the private Nuxt SSR-to-API hop. Required: generate 32+ URL-safe random characters.
XCS_INTERNAL_API_TOKEN=
XCS_INTERNAL_API_TOKEN_FILE=./ops/secrets/internal_api_token
# Optional internal operational snapshot. Use a distinct 32+ character token when enabled.
XCS_METRICS_ENABLED=false
XCS_METRICS_TOKEN=
# The production secret overlay requires this ignored file; when metrics are enabled it must contain
# the same distinct 32+ character token consumed by both the API and Prometheus.
XCS_METRICS_TOKEN_FILE=./ops/secrets/xcs_metrics_token
XCS_METRICS_RETENTION=30d
# Grafana has no default password. Put a distinct random value in this ignored file.
XCS_GRAFANA_ADMIN_USER=xcs_admin
XCS_GRAFANA_ADMIN_PASSWORD_FILE=./ops/secrets/grafana_admin_password
XCS_GRAFANA_COOKIE_SECURE=true
# Administrator access is bootstrap-only; runtime processes must not use it.
XCS_BOOTSTRAP_DATABASE_URL=postgres://xcs_admin:replace-with-a-long-url-safe-random-admin-password@localhost:5432/xcs
XCS_INDEXER_DATABASE_URL=postgres://xcs_indexer:replace-with-a-long-url-safe-random-indexer-password@localhost:5432/xcs
# The API uses XCS_DATABASE_URL for backward compatibility.
XCS_DATABASE_URL=postgres://xcs_api:replace-with-a-long-url-safe-random-api-password@localhost:5432/xcs
XCS_API_HOST=0.0.0.0
XCS_API_PORT=3001
# Main-stack host bindings. All default to XCS_BIND_ADDRESS (loopback here).
XCS_API_PORT_PUBLISHED=3001
XCS_WEB_PORT_PUBLISHED=3000
# Development-override bindings; unused unless docker-compose.dev.yml and the relevant profile run.
XCS_POSTGRES_PORT_PUBLISHED=5432
XCS_PROMETHEUS_PORT_PUBLISHED=9090
XCS_GRAFANA_PORT_PUBLISHED=3002
XCS_IPFS_GATEWAY_PORT_PUBLISHED=8080
XCS_PUBLIC_API_BASE_URL=http://localhost:3001
XCS_PUBLIC_PROFILE_ID=commons-testnet-xcs-v0.1-controlled-pilot
XCS_ALLOWED_ORIGINS=http://localhost:3000
# Optional. Set only to narrow reverse-proxy IP/CIDR values that overwrite forwarded client-IP headers.
# Catch-all /0 networks are rejected. Compose applies this trust list to both API and web SSR.
XCS_TRUSTED_PROXY_CIDRS=
XCS_READINESS_MAX_LEDGER_AGE_SECONDS=120
# The controlled pilot primary is a Commons-operated complete-history rippled endpoint supplied
# out of band. Leave it empty rather than committing a hostname, credential or deployable fake.
XCS_RPC_URL_PRIMARY=
XCS_RPC_URL_PRIMARY_FILE=./ops/secrets/rpc_url_primary
# Public pilot fallback operated by Ripple. It has no availability or retention SLA for XCS.
XCS_RPC_URL_SECONDARY=wss://s.altnet.rippletest.net:51233
XCS_RPC_URL_SECONDARY_FILE=./ops/secrets/rpc_url_secondary
# Public, browser-reachable endpoint. Never put credentials or a private indexer URL here.
# This XRPL Labs public service has no availability SLA for XCS and is not verification authority.
XCS_PUBLIC_RPC_URL=wss://testnet.xrpl-labs.com/
# Safe default for every normal profile. The private controlled pilot requires both explicit
# values documented in ADR 0003; never enable them for a public beta profile.
XCS_REGISTRY_POLICY=blackholed
XCS_CONTROLLED_PILOT_ACK=
XCS_INDEXER_POLL_INTERVAL_MS=4000
XCS_INDEXER_BATCH_SIZE=20
XCS_INDEXER_LEASE_DURATION_MS=30000
# Optional immutable image/build pins. Production operators should replace tags with reviewed digests.
XCS_NODE_IMAGE=node:24-alpine
XCS_POSTGRES_IMAGE=postgres:18-alpine
XCS_DB_IMAGE=xcs-db:local
XCS_API_IMAGE=xcs-api:local
XCS_INDEXER_IMAGE=xcs-indexer:local
XCS_WEB_IMAGE=xcs-web:local
XCS_IPFS_IMAGE=ipfs/kubo:v0.35.0
XCS_PROMETHEUS_IMAGE=prom/prometheus:v3.14.0
XCS_GRAFANA_IMAGE=grafana/grafana:13.1.0
XCS_POSTGRES_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter:v0.20.1
XCS_NODE_EXPORTER_IMAGE=prom/node-exporter:v1.12.1
XCS_REVISION=local
XCS_VERSION=0.1.0-alpha.1
# Bounded runtime defaults; tune only from measured deployment evidence.
XCS_LOG_MAX_SIZE=10m
XCS_LOG_MAX_FILES=5
XCS_POSTGRES_MEMORY_LIMIT=1g
XCS_POSTGRES_CPU_LIMIT=1.0
XCS_JOB_MEMORY_LIMIT=512m
XCS_JOB_CPU_LIMIT=0.5
XCS_API_MEMORY_LIMIT=512m
XCS_API_CPU_LIMIT=0.75
XCS_INDEXER_MEMORY_LIMIT=768m
XCS_INDEXER_CPU_LIMIT=1.0
XCS_WEB_MEMORY_LIMIT=512m
XCS_WEB_CPU_LIMIT=0.75
XCS_IPFS_MEMORY_LIMIT=1g
XCS_IPFS_CPU_LIMIT=1.0
XCS_PROMETHEUS_MEMORY_LIMIT=768m
XCS_PROMETHEUS_CPU_LIMIT=0.75
XCS_GRAFANA_MEMORY_LIMIT=512m
XCS_GRAFANA_CPU_LIMIT=0.5
XCS_EXPORTER_MEMORY_LIMIT=128m
XCS_EXPORTER_CPU_LIMIT=0.25
# Required together for live replay; optional exact-boundary cross-check in fixture replay.
XCS_REPLAY_TARGET_LEDGER_INDEX=
XCS_REPLAY_TARGET_LEDGER_HASH=
# Optional offline replay: both values are required together and replace live RPC input.
XCS_REPLAY_FIXTURE_BUNDLE=
XCS_REPLAY_FIXTURE_BUNDLE_SHA256=
# Required only by `fixture:capture`; capture always starts at profile activation.
XCS_FIXTURE_TARGET_LEDGER_INDEX=
XCS_FIXTURE_OUTPUT=
XCS_FIXTURE_PRIMARY_OPERATOR=XRPL Commons
# Descriptive capture label only; it is not proof of availability, retention or independence.
XCS_FIXTURE_SECONDARY_OPERATOR=Ripple
# Required only by `fixture:validate`.
XCS_FIXTURE_BUNDLE=
# SHA-256 printed by fixture:capture for the exact canonical manifest.json bytes.
XCS_FIXTURE_BUNDLE_SHA256=
XCS_PAYLOAD_FETCH_ENABLED=false
XCS_IPFS_API_URL=http://localhost:5001
XCS_IPFS_GATEWAY_URL=https://ipfs.io/
XCS_DEMO_PINNING_ENABLED=false
XCS_PINNING_NETWORKS=
# Static pilot trust policy. Comma-separated XRPL classic addresses.
XCS_TRUSTED_ISSUERS=
XCS_UNTRUSTED_ISSUERS=
# Required only when XCS_DEMO_PINNING_ENABLED=true; use at least 32 random bytes.
XCS_PINNING_IP_HASH_SECRET=
