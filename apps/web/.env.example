# Contract for the XCS web app (Nuxt server + the /v1 read API).
# Names only; values live in the deployment's secret store.
# Read-only PostgreSQL connection string for the API role.
XCS_DATABASE_URL=                          # config
# Comma-separated browser origins allowed on /v1/**; `*` is rejected.
XCS_ALLOWED_ORIGINS=                       # config
# Narrow reverse-proxy CIDRs trusted for forwarded client-IP headers; catch-all /0 is rejected.
XCS_TRUSTED_PROXY_CIDRS=                   # optional config
# Readiness fails when the newest indexed ledger is older than this many seconds.
XCS_READINESS_MAX_LEDGER_AGE_SECONDS=      # optional config
# Internal operational snapshot at /internal/metrics/prometheus.
XCS_METRICS_ENABLED=                       # optional config
# Bearer token guarding that route; 32+ URL-safe characters when metrics are enabled.
XCS_METRICS_TOKEN=                         # optional generate
# Server-side fetching of credential payloads.
XCS_PAYLOAD_FETCH_ENABLED=                 # optional config
# Gateway used to fetch ipfs:// payloads.
XCS_IPFS_GATEWAY_URL=                      # optional config
# Demonstration-only pinning endpoint.
XCS_DEMO_PINNING_ENABLED=                  # optional config
# Kubo RPC endpoint used by the demo pinning service.
XCS_IPFS_API_URL=                          # optional config
# Salt for hashing pinning client addresses; at least 32 random bytes when pinning is enabled.
XCS_PINNING_IP_HASH_SECRET=                # optional generate
# Profile identifiers on which demo pinning is offered.
XCS_PINNING_NETWORKS=                      # optional config
# Static pilot trust policy; comma-separated XRPL classic addresses.
XCS_TRUSTED_ISSUERS=                       # optional config
XCS_UNTRUSTED_ISSUERS=                     # optional config
# Network profile served by this deployment.
NUXT_PUBLIC_PROFILE_ID=                    # config
# Public wss:// XRPL submission endpoint; no credentials, no private indexer URL.
NUXT_PUBLIC_RPC_URL=                       # config
# Public Xaman application identifier; enables the Xaman adapter.
NUXT_PUBLIC_XAMAN_API_KEY=                 # optional
# Public Reown project identifier; enables the WalletConnect adapter.
NUXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=     # optional

# Optional account and organization workspaces. Disabled unless their flag is 1.
XCS_AUTH_ENABLED=                         # optional config
XCS_AUTH_ORIGIN=                          # optional config; exact HTTPS origin
XCS_IDENTITY_CLIENT_ID=                   # optional held
XCS_IDENTITY_CLIENT_SECRET=               # optional held
NUXT_APP_DATABASE_URL=                    # optional held; xcs_app role
XCS_ADMIN_ENABLED=                        # optional config
NUXT_ADMIN_DATABASE_URL=                  # optional held; xcs_admin_app role
XCS_ADMIN_DOCUMENT_KEY=                   # optional generate
XCS_ADMIN_DOCUMENT_DIRECTORY=             # optional config; private directory
XCS_ISSUER_ENABLED=                       # optional config
NUXT_PUBLIC_ISSUER_ENABLED=               # optional config; navigation only
NUXT_ISSUER_DATABASE_URL=                 # optional held; xcs_issuer role
XCS_ISSUER_DOCUMENT_DIRECTORY=            # optional config; private writable directory
XCS_ISSUER_INVITE_DAYS=                    # optional config; default 7, maximum 30
XCS_NOTIFIER_DATABASE_URL=                # optional held; notification worker only
XCS_SMTP_HOST=                            # optional config; local transport
XCS_SMTP_PORT=                            # optional config
# Optional public payload publication uses its own restricted connection.
XCS_PAYLOAD_DATABASE_URL=                 # optional held; xcs_payload_writer role
XCS_HOSTED_PAYLOADS_ENABLED=              # optional config
XCS_PUBLIC_PAYLOAD_BASE_URL=               # optional config; exact HTTPS origin
XCS_PAYLOAD_STORAGE_IP_HASH_SECRET=       # optional generate
XCS_HOSTED_PAYLOAD_NETWORKS=             # optional config
NUXT_PUBLIC_PAYLOAD_BASE_URL=             # optional config
