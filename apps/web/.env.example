# XCS web deployment contract. Behavioural settings live in
# server/xcs/settings.ts; this file contains only secrets and values that differ
# between deployments.

# Public API and network.
XCS_DATABASE_URL=                          # held; xcs_api PostgreSQL URL
XCS_ALLOWED_ORIGINS=                       # config; explicit comma-separated origins
XCS_TRUSTED_PROXY_CIDRS=                   # optional config
XCS_METRICS_TOKEN=                         # optional generate; presence enables metrics
XCS_PINNING_IP_HASH_SECRET=                # optional generate; demo pinning only
XCS_NETWORK_PROFILE=                       # optional config; same JSON as the indexer
NUXT_PUBLIC_RPC_URL=                       # config; public wss:// submission endpoint
NUXT_PUBLIC_XAMAN_API_KEY=                 # optional public identifier
NUXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=     # optional public identifier

# Account workspace. Supplying any field requires the complete group; a complete
# group enables authentication without a separate feature flag.
XCS_AUTH_ORIGIN=                           # config; exact HTTPS origin
XCS_IDENTITY_CLIENT_ID=                    # held
XCS_IDENTITY_CLIENT_SECRET=                # held
NUXT_APP_DATABASE_URL=                     # held; xcs_app PostgreSQL URL

# Commons review workspace. Supplying its database/key enables it after auth.
NUXT_ADMIN_DATABASE_URL=                   # held; xcs_admin_app PostgreSQL URL
XCS_ADMIN_DOCUMENT_KEY=                    # generate

# Issuer workspace. Supplying its database enables it after auth. The browser
# navigation is derived from this same validated server contract.
NUXT_ISSUER_DATABASE_URL=                  # held; xcs_issuer PostgreSQL URL

# Shared private evidence storage. Filesystem is local-only; production uses a
# private S3-compatible bucket such as DigitalOcean Spaces.
XCS_DOCUMENT_STORAGE_DRIVER=              # config; filesystem or s3
XCS_DOCUMENT_FILESYSTEM_DIRECTORY=        # local-only absolute private directory
XCS_DOCUMENT_FILESYSTEM_LOCAL=            # local-only acknowledgement; must be 1
XCS_DOCUMENT_S3_ENDPOINT=                 # config; exact HTTPS origin
XCS_DOCUMENT_S3_REGION=                   # config
XCS_DOCUMENT_S3_BUCKET=                   # config; private bucket
XCS_DOCUMENT_S3_PRIVATE_BUCKET=           # production acknowledgement; must be 1
XCS_DOCUMENT_S3_PREFIX=                   # optional config
XCS_DOCUMENT_S3_ACCESS_KEY_ID=             # held
XCS_DOCUMENT_S3_SECRET_ACCESS_KEY=         # held

# Invitation and lifecycle email. External SMTP must use starttls or tls.
XCS_SMTP_HOST=                             # optional config
XCS_SMTP_PORT=                             # optional config
XCS_SMTP_TLS_MODE=                         # optional config; disabled/starttls/tls
XCS_SMTP_USERNAME=                         # optional held; pair with password
XCS_SMTP_PASSWORD=                         # optional held; pair with username
XCS_SMTP_FROM_NAME=                        # optional config
XCS_SMTP_FROM_ADDRESS=                     # required for external SMTP
XCS_SMTP_ENVELOPE_FROM=                    # optional config

# Public hosted payloads. Supplying any hosted value requires the complete
# group and enables publication; the browser origin is derived from it.
XCS_PAYLOAD_DATABASE_URL=                  # optional held; xcs_payload_writer URL
XCS_PUBLIC_PAYLOAD_BASE_URL=               # optional config; exact HTTPS origin
XCS_PAYLOAD_STORAGE_IP_HASH_SECRET=        # optional generate
XCS_HOSTED_PAYLOAD_NETWORKS=               # optional config
