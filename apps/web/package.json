{
  "name": "@xcs-protocol/web",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "XCS_BROWSER_E2E=0 XCS_LOCAL_PAYLOAD_STORE=0 nuxt build",
    "clean": "rm -rf .nuxt .output coverage",
    "dev": "nuxt dev",
    "lint": "NODE_ENV=development XCS_BROWSER_E2E=0 XCS_LOCAL_PAYLOAD_STORE=0 nuxt typecheck",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:security": "playwright test --config playwright.security.config.ts",
    "typecheck": "NODE_ENV=development XCS_BROWSER_E2E=0 XCS_LOCAL_PAYLOAD_STORE=0 nuxt typecheck"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.0.6",
    "@xcs-protocol/core": "workspace:*",
    "@xcs-protocol/sdk": "workspace:*",
    "ipaddr.js": "^2.2.0",
    "nuxt": "^4.5.2",
    "nuxt-security": "2.6.0",
    "vue": "^3.5.21",
    "vue-router": "^5.2.0",
    "xrpl": "^5.0.0",
    "xrpl-connect": "1.0.0-rc.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.2"
  }
}
