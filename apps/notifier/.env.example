# Contract for the XCS administrator notification worker.
# Names only; values live in the deployment's secret store.
XCS_NOTIFIER_DATABASE_URL=                # held (xcs_notifier role)
XCS_SMTP_HOST=                            # config
XCS_SMTP_PORT=                            # config
# External servers must use `starttls` or `tls`; only local Mailpit may use `disabled`.
XCS_SMTP_TLS_MODE=                        # config (disabled, starttls, or tls)
XCS_SMTP_USERNAME=                        # optional held (pair with XCS_SMTP_PASSWORD)
XCS_SMTP_PASSWORD=                        # optional held (pair with XCS_SMTP_USERNAME)
XCS_SMTP_FROM_NAME=                       # optional config
XCS_SMTP_FROM_ADDRESS=                    # config (required for external SMTP)
XCS_SMTP_ENVELOPE_FROM=                   # optional config (defaults to FROM_ADDRESS)
