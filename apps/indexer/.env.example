# Contract for the XCS indexer worker.
# Names only; values live in the deployment's secret store.
# Path to the network profile JSON this worker indexes.
XCS_NETWORK_PROFILE=                       # config
# PostgreSQL connection string for the indexer role.
XCS_INDEXER_DATABASE_URL=                  # config
# Commons-operated complete-history rippled endpoint, supplied out of band.
XCS_RPC_URL_PRIMARY=                       # held
# Public fallback endpoint; no availability or retention SLA for XCS.
XCS_RPC_URL_SECONDARY=                     # held
# Registry policy; `blackholed` is the safe default for every normal profile.
XCS_REGISTRY_POLICY=                       # optional config
# Explicit acknowledgement required only by the private controlled pilot (ADR 0003).
XCS_CONTROLLED_PILOT_ACK=                  # optional config
XCS_DATABASE_SCOPE=                        # optional config
XCS_INDEXER_POLL_INTERVAL_MS=              # optional config
XCS_INDEXER_LEASE_DURATION_MS=             # optional config
XCS_INDEXER_BATCH_SIZE=                    # optional config
# The values below are read only by db:bootstrap, run once from an operator
# machine or a one-off job against the external database. The long-running
# service reads only the variables above.
XCS_BOOTSTRAP_DATABASE_URL=                # optional held
# Must be exactly `dedicated`: db:bootstrap creates cluster-wide roles and refuses
# to run on a cluster it does not own.
XCS_DATABASE_CLUSTER_SCOPE=                # optional config
XCS_INDEXER_DATABASE_PASSWORD=             # optional generate
XCS_API_DATABASE_PASSWORD=                 # optional generate
XCS_MONITOR_DATABASE_PASSWORD=             # optional generate
# Required by bootstrap, including when hosted payload publishing is disabled.
XCS_PAYLOAD_DATABASE_PASSWORD=             # optional generate; required for bootstrap
# Optional application capabilities: omit each variable entirely when disabled.
# An explicitly empty password is invalid. These are separate least-privilege roles.
XCS_APP_DATABASE_PASSWORD=                 # optional generate; auth role xcs_app
XCS_ADMIN_DATABASE_PASSWORD=               # optional generate; review role xcs_admin_app
XCS_NOTIFIER_DATABASE_PASSWORD=            # optional generate; worker role xcs_notifier
XCS_ISSUER_DATABASE_PASSWORD=              # optional generate; workspace role xcs_issuer
