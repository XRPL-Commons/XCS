# Runtime worker contract. Secrets and deployment-specific values are supplied by
# the deployment platform; worker behaviour defaults live in src/settings.ts.
XCS_INDEXER_DATABASE_URL=                  # held
XCS_RPC_URL_PRIMARY=                       # held
# Public fallback endpoint; no availability or retention SLA for XCS.
XCS_RPC_URL_SECONDARY=                     # held

# Path to the same published network profile JSON served by the web app.
XCS_NETWORK_PROFILE=                       # config

# Safe defaults live in src/settings.ts. These three overrides exist only for the
# disposable controlled Testnet pilot described by ADR 0003.
XCS_REGISTRY_POLICY=                       # optional config
XCS_CONTROLLED_PILOT_ACK=                  # optional config
XCS_DATABASE_SCOPE=                        # optional config
