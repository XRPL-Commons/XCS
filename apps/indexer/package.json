{
  "name": "@xcs-protocol/indexer",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "db:bootstrap": "tsx src/lib/db/bin/bootstrap.ts",
    "db:generate": "NODE_PATH=./node_modules drizzle-kit generate --config ../../db/drizzle.config.ts",
    "db:migrate": "tsx src/lib/db/bin/migrate.ts",
    "dev": "tsx watch src/main.ts",
    "fixture:capture": "tsx src/fixture-cli.ts capture",
    "fixture:validate": "tsx src/fixture-cli.ts validate",
    "format:check": "prettier --check .",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit",
    "maintenance": "tsx src/maintenance.ts",
    "preflight": "tsx src/maintenance.ts preflight",
    "projection:digest": "tsx src/maintenance.ts projection-digest",
    "replay": "tsx src/maintenance.ts replay",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:postgres": "XCS_REQUIRE_POSTGRES_TESTS=1 vitest run --no-file-parallelism test/db/migrations.integration.test.ts test/db/app-model.integration.test.ts test/db/auth.integration.test.ts test/db/admin.integration.test.ts test/postgres.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "db:status": "tsx src/lib/db/bin/status.ts",
    "admin:bootstrap": "tsx src/lib/db/bin/admin-bootstrap.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "@scure/base": "2.3.0",
    "canonicalize": "4.0.0",
    "drizzle-orm": "^0.45.2",
    "jsonc-parser": "3.3.1",
    "multiformats": "14.0.5",
    "postgres": "^3.4.7",
    "ripple-binary-codec": "2.11.0",
    "tr46": "4.1.1",
    "xrpl": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.4",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "svgo@>=4.0.0 <4.1.0": ">=4.1.0"
    }
  }
}
