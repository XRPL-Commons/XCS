{
  "name": "@xcs-protocol/indexer",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "db:bootstrap": "tsx src/lib/db/bin/bootstrap.ts",
    "db:generate": "cd ../../db && drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "tsx src/lib/db/bin/migrate.ts",
    "dev": "tsx watch src/main.ts",
    "fixture:capture": "tsx src/fixture-cli.ts capture",
    "fixture:validate": "tsx src/fixture-cli.ts validate",
    "lint": "tsc -p tsconfig.json --noEmit",
    "maintenance": "tsx src/maintenance.ts",
    "preflight": "tsx src/maintenance.ts preflight",
    "projection:digest": "tsx src/maintenance.ts projection-digest",
    "replay": "tsx src/maintenance.ts replay",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:postgres": "XCS_REQUIRE_POSTGRES_TESTS=1 vitest run test/postgres.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xcs-protocol/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7",
    "xrpl": "^5.0.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4"
  }
}
