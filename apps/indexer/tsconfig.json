{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "paths": {
      "#db/*": ["../../db/*"],
      "drizzle-orm": ["./node_modules/drizzle-orm"],
      "drizzle-orm/*": ["./node_modules/drizzle-orm/*"],
      "drizzle-kit": ["./node_modules/drizzle-kit"]
    },
    "baseUrl": ".",
    "module": "Preserve",
    "moduleResolution": "Bundler"
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../../db/**/*.ts",
    "tsup.config.ts",
    "vitest.config.ts"
  ]
}
