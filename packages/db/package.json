{
  "name": "@xcs-protocol/db",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "import": "./dist/bootstrap.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/schema/index.ts src/bootstrap.ts src/bin/bootstrap.ts --format esm --dts --clean",
    "clean": "rm -rf dist coverage",
    "db:generate": "drizzle-kit generate",
    "db:bootstrap": "tsx src/bin/bootstrap.ts",
    "bootstrap": "tsx src/bin/bootstrap.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4"
  }
}
