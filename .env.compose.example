# Local development Compose stack. Copy to .env, then `docker compose up --build`.
# This file is not a deployment contract: the hosted contracts are
# apps/web/.env.example and apps/indexer/.env.example.

# --- Passwords (local development values; Compose composes the connection URLs) ---
# db:bootstrap creates fixed cluster-wide roles and is safe only on a dedicated cluster.
XCS_POSTGRES_ADMIN_PASSWORD=replace-with-a-long-url-safe-random-admin-password
XCS_INDEXER_DATABASE_PASSWORD=replace-with-a-long-url-safe-random-indexer-password
XCS_API_DATABASE_PASSWORD=replace-with-a-long-url-safe-random-api-password
# Dedicated pg_monitor identity for postgres-exporter; no application-table DML rights.
XCS_MONITOR_DATABASE_PASSWORD=replace-with-a-long-url-safe-random-monitor-password

# --- Indexer ---
# Container path. A controlled-pilot profile is dropped into ./config/networks and named here.
XCS_NETWORK_PROFILE=/workspace/config/networks/testnet.example.json
XCS_DATABASE_SCOPE=exclusive-profile
# Local development points both endpoints at public testnet services, which have no
# availability or retention SLA for XCS. A deployment uses the Commons-operated
# complete-history endpoint supplied out of band; never commit it here.
XCS_RPC_URL_PRIMARY=wss://s.altnet.rippletest.net:51233
XCS_RPC_URL_SECONDARY=wss://testnet.xrpl-labs.com/
# Safe default for every normal profile. The private controlled pilot requires both
# explicit values documented in ADR 0003; never enable them for a public beta profile.
XCS_REGISTRY_POLICY=blackholed
XCS_CONTROLLED_PILOT_ACK=
XCS_INDEXER_POLL_INTERVAL_MS=4000
XCS_INDEXER_BATCH_SIZE=20
XCS_INDEXER_LEASE_DURATION_MS=30000

# --- Web app (Nuxt server and the /v1 read API) ---
XCS_ALLOWED_ORIGINS=http://localhost:3000
# Optional. Narrow reverse-proxy IP/CIDR values that overwrite forwarded client-IP
# headers. Catch-all /0 networks are rejected.
XCS_TRUSTED_PROXY_CIDRS=
XCS_READINESS_MAX_LEDGER_AGE_SECONDS=120
# Optional internal operational snapshot. Use a distinct 32+ character token when enabled;
# the monitoring profile gives Prometheus the same value as its scrape credential.
XCS_METRICS_ENABLED=false
XCS_METRICS_TOKEN=
# Prometheus can only read the bearer token from a file, so the monitoring profile mounts
# this path as the `xcs_metrics_token` Compose secret. Create it explicitly before starting
# the profile (it is never committed):
#   printf '%s' "$XCS_METRICS_TOKEN" > ops/secrets/xcs_metrics_token
# Keep the directory 0700 and the file 0644: the secret is bind-mounted with its host mode,
# so a stricter file is unreadable inside the container. See docs/runbooks/monitoring.md.
XCS_METRICS_TOKEN_FILE=./ops/secrets/xcs_metrics_token
XCS_PAYLOAD_FETCH_ENABLED=false
XCS_IPFS_GATEWAY_URL=https://ipfs.io/
XCS_IPFS_API_URL=http://ipfs:5001
XCS_DEMO_PINNING_ENABLED=false
XCS_PINNING_NETWORKS=
# Required only when XCS_DEMO_PINNING_ENABLED=true; use at least 32 random bytes.
XCS_PINNING_IP_HASH_SECRET=
# Static pilot trust policy. Comma-separated XRPL classic addresses.
XCS_TRUSTED_ISSUERS=
XCS_UNTRUSTED_ISSUERS=
# Browser-visible values.
XCS_PUBLIC_PROFILE_ID=xrpl-testnet-xcs-v0.1
# Public, browser-reachable endpoint. Never put credentials or a private indexer URL here.
XCS_PUBLIC_RPC_URL=wss://testnet.xrpl-labs.com/
# Optional Xaman OAuth configuration. The API key is public. Register the exact redirect URL
# in the Xaman Developer Console; it must be this deployment's origin with a trailing slash.
XCS_PUBLIC_XAMAN_API_KEY=
XCS_PUBLIC_XAMAN_REDIRECT_URL=http://localhost:3000/
XCS_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# --- Host bindings ---
XCS_BIND_ADDRESS=127.0.0.1
XCS_WEB_PORT_PUBLISHED=3000
# Used only with docker-compose.dev.yml and the relevant profile.
XCS_POSTGRES_PORT_PUBLISHED=5432
XCS_PROMETHEUS_PORT_PUBLISHED=9090
XCS_GRAFANA_PORT_PUBLISHED=3002
XCS_IPFS_GATEWAY_PORT_PUBLISHED=8080

# --- monitoring profile ---
XCS_METRICS_RETENTION=30d
# Grafana has no default password; set a distinct random value before enabling the profile.
XCS_GRAFANA_ADMIN_USER=xcs_admin
XCS_GRAFANA_ADMIN_PASSWORD=
# Local development is plain HTTP; set true behind TLS.
XCS_GRAFANA_COOKIE_SECURE=false

# --- Image pins ---
XCS_POSTGRES_IMAGE=postgres:18-alpine
XCS_INDEXER_IMAGE=xcs-indexer:local
XCS_WEB_IMAGE=xcs-web:local
XCS_IPFS_IMAGE=ipfs/kubo:v0.35.0
XCS_PROMETHEUS_IMAGE=prom/prometheus:v3.14.0
XCS_GRAFANA_IMAGE=grafana/grafana:13.1.0
XCS_POSTGRES_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter:v0.20.1
XCS_NODE_EXPORTER_IMAGE=prom/node-exporter:v1.12.1

# --- Bounded runtime defaults; tune only from measured evidence ---
XCS_LOG_MAX_SIZE=10m
XCS_LOG_MAX_FILES=5
XCS_POSTGRES_MEMORY_LIMIT=1g
XCS_POSTGRES_CPU_LIMIT=1.0
XCS_JOB_MEMORY_LIMIT=512m
XCS_JOB_CPU_LIMIT=0.5
XCS_INDEXER_MEMORY_LIMIT=768m
XCS_INDEXER_CPU_LIMIT=1.0
XCS_WEB_MEMORY_LIMIT=768m
XCS_WEB_CPU_LIMIT=0.75
XCS_IPFS_MEMORY_LIMIT=1g
XCS_IPFS_CPU_LIMIT=1.0
XCS_PROMETHEUS_MEMORY_LIMIT=768m
XCS_PROMETHEUS_CPU_LIMIT=0.75
XCS_GRAFANA_MEMORY_LIMIT=512m
XCS_GRAFANA_CPU_LIMIT=0.5
XCS_EXPORTER_MEMORY_LIMIT=128m
XCS_EXPORTER_CPU_LIMIT=0.25
